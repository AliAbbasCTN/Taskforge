# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Which environment the app believes it is running in. Affects logging and
# error verbosity. One of: development | test | production
NODE_ENV=development

# The HTTP port the backend listens on.
PORT=3000

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# The frontend's origin, allowed to call this API with credentials.
# Default matches Vite's dev server port, used from Phase 09 onward.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# API documentation (Phase 16; optional)
# ---------------------------------------------------------------------------
# Serve the interactive API reference at /docs (raw OpenAPI at /docs-json and
# /docs-yaml). When omitted: ON in development and test, OFF in production -
# an API map helps attackers as much as developers, so enabling it in
# production is a deliberate choice. Set to true or false to override.
# SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# PostgreSQL connection string, read by both Prisma and the app config.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# The value below matches the Postgres container defined in
# docker-compose.yml at the project root - if you use that, it works as-is.
DATABASE_URL=postgresql://taskforge:taskforge@localhost:5432/taskforge?schema=public

# ---------------------------------------------------------------------------
# Redis (used from Phase 12; optional - this default is used if omitted)
# ---------------------------------------------------------------------------
# Redis backs the background-job queues (BullMQ) and lets several server
# instances share real-time (WebSocket) events. The value below matches the
# Redis container in docker-compose.yml.
# Use rediss:// (two s) for a TLS connection, and include credentials as
# redis://:PASSWORD@host:6379 when your Redis requires a password.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Secrets used to sign JWTs. Generate real ones with:
#   openssl rand -base64 32
# NEVER reuse these example values, and NEVER use the same secret for both -
# see docs/phase-03-concepts.md for why.
JWT_ACCESS_SECRET=replace-with-a-random-32-plus-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-character-secret

# How long an access token is valid before the client must refresh it.
JWT_ACCESS_EXPIRES_IN=15m

# How long a refresh token is valid before the user must log in again.
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# File uploads / attachments (Phase 13; every variable here is optional)
# ---------------------------------------------------------------------------
# Where uploaded files are stored:
#   local - a folder on this machine (the default; for development)
#   s3    - an AWS S3 bucket (for production; needs the S3_* settings below)
STORAGE_DRIVER=local

# local driver only: the folder files are written to. A relative path is
# resolved from the backend/ directory. It is git-ignored; never commit uploads.
STORAGE_LOCAL_DIR=uploads

# The largest single file accepted, in megabytes (1-100). Uploads are held in
# memory while being checked, so keep this modest.
UPLOAD_MAX_FILE_SIZE_MB=10

# s3 driver only (required when STORAGE_DRIVER=s3):
# S3_BUCKET=taskforge-attachments
# S3_REGION=eu-west-1
#
# Only for S3-compatible services such as MinIO or LocalStack - omit for AWS:
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
#
# There are deliberately NO AWS access keys in this file. The AWS SDK finds
# credentials on its own: on AWS, attach an IAM role to the server (no keys
# at all); locally you may export AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or
# use `aws configure`. See docs/phase-13-concepts.md.

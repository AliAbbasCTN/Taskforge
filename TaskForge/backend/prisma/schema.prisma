// TaskForge — Prisma schema
//
// This file is the single source of truth for TaskForge's database structure.
// Prisma reads it to (a) generate a fully type-safe database client, and
// (b) generate SQL migration files that evolve the real PostgreSQL schema.
//
// Models are introduced gradually, phase by phase — see docs/database-plan.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A TaskForge user account.
///
/// Phase 03 adds authentication fields. Phase 04 connects users to
/// Organizations via a membership join model.
model User {
  id    String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(255)
  name  String @db.VarChar(100)

  /// A bcrypt hash - never the plaintext password. See docs/phase-03-concepts.md
  /// for why we hash rather than encrypt, and why bcrypt specifically.
  passwordHash String @map("password_hash") @db.VarChar(255)

  /// A bcrypt hash of the user's current refresh token, or null if they are
  /// logged out. We store a HASH of the token, not the token itself - if the
  /// database were ever leaked, the stored value alone cannot be used to log
  /// in as the user (same reasoning as passwordHash).
  hashedRefreshToken String? @map("hashed_refresh_token") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// TaskForge — Prisma schema
//
// This file is the single source of truth for TaskForge's database structure.
// Prisma reads it to (a) generate a fully type-safe database client, and
// (b) generate SQL migration files that evolve the real PostgreSQL schema.
//
// Models are introduced gradually, phase by phase — see docs/database-plan.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A TaskForge user account.
///
/// Phase 04 connects users to Organizations via the Membership join model.
model User {
  id    String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(255)
  name  String @db.VarChar(100)

  /// A bcrypt hash - never the plaintext password. See docs/phase-03-concepts.md
  /// for why we hash rather than encrypt, and why bcrypt specifically.
  passwordHash String @map("password_hash") @db.VarChar(255)

  /// A SHA-256 hash of the user's current refresh token, or null if they are
  /// logged out. We store a HASH of the token, not the token itself - if the
  /// database were ever leaked, the stored value alone cannot be used to log
  /// in as the user. See docs/phase-03-concepts.md for why this is SHA-256
  /// rather than bcrypt (a real bug we hit and fixed during that phase).
  hashedRefreshToken String? @map("hashed_refresh_token") @db.VarChar(255)

  memberships Membership[]
  teamMemberships TeamMembership[]
  projectMemberships ProjectMembership[]
  assignedTasks      Task[]
  comments           Comment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// A tenant on the TaskForge platform. Everything a team works on -
/// eventually teams, projects, boards, tasks - belongs to exactly one
/// Organization. A User can belong to multiple Organizations (via
/// Membership), but data belonging to one Organization must never be
/// visible to a user who isn't a member of it. That boundary is enforced in
/// application code (see OrganizationMembershipGuard), not just by this
/// schema - the schema only makes the boundary representable.
model Organization {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(150)

  /// A URL-safe, human-readable identifier, generated from `name` at
  /// creation time. Not used for routing yet (routes use `id`) - it exists
  /// now because retrofitting a unique slug onto an existing table later,
  /// once organizations already exist with colliding names, is more painful
  /// than reserving the column now.
  slug String @unique @db.VarChar(160)

  memberships Membership[]
  teams       Team[]
  projects    Project[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

/// Which role a Membership grants within its Organization.
///
/// MANAGER exists in the schema now but isn't given any distinct
/// permissions yet - Phase 06 (RBAC) is where ADMIN/MANAGER/MEMBER actually
/// diverge in what they're allowed to do. For this phase, every check that
/// cares about role only distinguishes ADMIN from "everyone else".
enum MembershipRole {
  ADMIN
  MANAGER
  MEMBER
}

/// The join model connecting a User to an Organization, with a role. This
/// is the single source of truth for "who belongs to which organization,
/// and with what permissions" - every tenant-isolation check in the app
/// ultimately comes down to "does a Membership row exist for this
/// user+organization pair".
model Membership {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @map("user_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  role MembershipRole @default(MEMBER)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // A user can only have ONE membership (one role) per organization -
  // prevents duplicate/conflicting rows for the same user+org pair.
  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

/// A smaller working group WITHIN an organization - e.g. "Engineering" or
/// "Design". A Team belongs to exactly one Organization; it does not exist
/// independently. Deleting an Organization cascades to delete its Teams.
///
/// Any member of an Organization can currently create a Team and see every
/// Team in their Organization (teams are not private groups within a
/// tenant - the tenant boundary is the Organization, not the Team). Only a
/// Team's own LEAD can rename it, delete it, or manage its membership.
model Team {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name           String @db.VarChar(150)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  TeamMembership[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("teams")
}

/// Which role a TeamMembership grants within its Team. Deliberately a
/// separate enum from MembershipRole - team-level permissions and
/// organization-level permissions are different concerns, and reusing one
/// enum for both would blur that a user's ADMIN status in the organization
/// says nothing about their role (or even membership) in any given Team.
enum TeamRole {
  LEAD
  MEMBER
}

/// The join model connecting a User to a Team. A precondition enforced in
/// application code (not the database): a user can only be added to a Team
/// if they are already a member of that Team's Organization - see
/// TeamsService.addMember() and docs/phase-05-concepts.md.
model TeamMembership {
  id     String @id @default(uuid()) @db.Uuid
  teamId String @map("team_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  role TeamRole @default(MEMBER)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([userId])
  @@map("team_memberships")
}

/// Whether a Project is in active use. ARCHIVED is the reversible "put it
/// away" state - an archived project keeps all its data and members but is
/// read-only until someone unarchives it. This (plus permanent deletion,
/// which is only allowed from ARCHIVED) is why Project has no `deletedAt`
/// soft-delete column: archiving already IS the undoable step.
enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

/// A body of work inside an Organization - the thing boards and tasks will
/// belong to (Phase 08). A Project belongs to exactly one Organization;
/// deleting the Organization cascades to delete its Projects.
///
/// Unlike Teams, projects are NOT visible to every organization member: a
/// project is visible only to its own members, plus organization ADMINs and
/// MANAGERs who oversee everything. That visibility rule is enforced in
/// application code (see ProjectGuard) - the schema only stores who is a
/// member.
model Project {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name           String @db.VarChar(150)

  /// Optional free-text summary. NULL (not an empty string) means "none".
  description String? @db.VarChar(2000)

  status     ProjectStatus @default(ACTIVE)
  /// Set when the project is archived, cleared when it is unarchived.
  archivedAt DateTime?     @map("archived_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  ProjectMembership[]
  boards       Board[]
  labels       Label[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Serves "list this organization's projects, filtered by status" - the
  // main query. Because organizationId is the leading column, this one
  // composite index also serves plain "all projects in this org" lookups,
  // so a separate single-column organizationId index would be redundant.
  @@index([organizationId, status])
  @@map("projects")
}

/// Which role a ProjectMembership grants within its Project. A third
/// separate enum (alongside MembershipRole and TeamRole) for the same reason
/// TeamRole is separate from MembershipRole: a person's authority over an
/// organization, a team, and a project are three independent questions.
enum ProjectRole {
  LEAD
  MEMBER
}

/// The join model connecting a User to a Project. Two preconditions are
/// enforced in application code, not the database: the user must already be
/// a member of the Project's Organization (see ProjectsService.addMember()),
/// and when a user is removed from an Organization their ProjectMemberships
/// in it are removed too (see OrganizationsService.removeMember()).
model ProjectMembership {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  role ProjectRole @default(MEMBER)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([userId])
  @@map("project_memberships")
}

/// A kanban board inside a Project. A project can have several (for example
/// one per sprint or per workstream). A Board has no organizationId of its
/// own: tenant ownership flows down through Project -> Organization, and the
/// request guards verify every link in that chain (see BoardGuard).
model Board {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  name      String @db.VarChar(150)

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns BoardColumn[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("boards")
}

/// A vertical lane on a Board - "To Do", "In Progress", "Done". A task's
/// STATUS is simply which column it is in: there is deliberately no
/// separate status field on Task that could disagree with its column.
///
/// Named BoardColumn (not Column) to avoid colliding with the SQL/ORM
/// meaning of the word "column" everywhere it appears in code and docs.
model BoardColumn {
  id      String @id @default(uuid()) @db.Uuid
  boardId String @map("board_id") @db.Uuid
  name    String @db.VarChar(100)

  /// Zero-based order within the board. Kept dense (0,1,2...) by the
  /// service, which renumbers inside a transaction whenever a column is
  /// added, moved or removed. Intentionally NOT unique: a unique constraint
  /// would make swapping two columns impossible without temporarily
  /// violating it. See docs/phase-08-concepts.md.
  position Int

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([boardId, position])
  @@map("board_columns")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// A unit of work, sitting in exactly one column. Moving a task between
/// columns is how its status changes.
model Task {
  id       String @id @default(uuid()) @db.Uuid
  columnId String @map("column_id") @db.Uuid
  title    String @db.VarChar(200)

  /// NULL (never "") means no description.
  description String?      @db.VarChar(5000)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date")

  /// Must be a member of the task's project - enforced in application code
  /// (TasksService) and kept true when members leave (tasks are unassigned).
  /// If the user ACCOUNT is deleted the task survives, unassigned.
  assigneeId String? @map("assignee_id") @db.Uuid

  /// Zero-based order within the column; same rules as BoardColumn.position.
  position Int

  column   BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee User?       @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  labels   TaskLabel[]
  comments Comment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([columnId, position])
  @@index([assigneeId])
  @@map("tasks")
}

/// A tag that can be attached to tasks, scoped to ONE project: each project
/// keeps its own vocabulary ("bug", "design", "blocked"), so a label in one
/// project is invisible in every other. Deleting the project deletes its
/// labels; deleting a label just detaches it from tasks (via TaskLabel).
model Label {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  name      String @db.VarChar(50)

  /// A "#RRGGBB" hex colour, validated by the API (CreateLabelDto).
  color String @db.VarChar(7)

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskLabel[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // A project can't have two labels with the same name. This is an exact
  // (case-sensitive) match: "Bug" and "bug" are distinct to the database.
  @@unique([projectId, name])
  @@map("labels")
}

/// The join table for the many-to-many between Task and Label: a task can
/// have many labels, a label can be on many tasks. The pair is the primary
/// key, so attaching the same label twice is impossible by construction.
///
/// Application code (TasksService.setLabels) additionally guarantees the label
/// and the task belong to the SAME project - the schema can't express that,
/// the same way ProjectMembership can't express "user is in the organization".
model TaskLabel {
  taskId  String @map("task_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  // "Which tasks have this label?" - the filter query. The primary key
  // already serves the other direction (task -> its labels).
  @@index([labelId])
  @@map("task_labels")
}

/// A comment on a task. The author is nullable with SetNull: if a user
/// ACCOUNT is deleted their comments stay (a conversation with half its
/// messages missing makes no sense) and show as written by a former member.
model Comment {
  id       String  @id @default(uuid()) @db.Uuid
  taskId   String  @map("task_id") @db.Uuid
  authorId String? @map("author_id") @db.Uuid
  body     String  @db.VarChar(5000)

  /// Set when the body is edited, so the UI can show "(edited)". NULL means
  /// never edited. (Not derived from updatedAt, which Prisma also bumps on
  /// create.)
  editedAt DateTime? @map("edited_at")

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // "A task's comments, oldest first" - the only way comments are read.
  @@index([taskId, createdAt])
  @@index([authorId])
  @@map("comments")
}

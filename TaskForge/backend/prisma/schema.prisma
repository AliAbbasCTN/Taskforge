// TaskForge — Prisma schema
//
// This file is the single source of truth for TaskForge's database structure.
// Prisma reads it to (a) generate a fully type-safe database client, and
// (b) generate SQL migration files that evolve the real PostgreSQL schema.
//
// Models are introduced gradually, phase by phase — see docs/database-plan.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A TaskForge user account.
///
/// Phase 04 connects users to Organizations via the Membership join model.
model User {
  id    String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(255)
  name  String @db.VarChar(100)

  /// A bcrypt hash - never the plaintext password. See docs/phase-03-concepts.md
  /// for why we hash rather than encrypt, and why bcrypt specifically.
  passwordHash String @map("password_hash") @db.VarChar(255)

  /// A SHA-256 hash of the user's current refresh token, or null if they are
  /// logged out. We store a HASH of the token, not the token itself - if the
  /// database were ever leaked, the stored value alone cannot be used to log
  /// in as the user. See docs/phase-03-concepts.md for why this is SHA-256
  /// rather than bcrypt (a real bug we hit and fixed during that phase).
  hashedRefreshToken String? @map("hashed_refresh_token") @db.VarChar(255)

  memberships Membership[]
  teamMemberships TeamMembership[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// A tenant on the TaskForge platform. Everything a team works on -
/// eventually teams, projects, boards, tasks - belongs to exactly one
/// Organization. A User can belong to multiple Organizations (via
/// Membership), but data belonging to one Organization must never be
/// visible to a user who isn't a member of it. That boundary is enforced in
/// application code (see OrganizationMembershipGuard), not just by this
/// schema - the schema only makes the boundary representable.
model Organization {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(150)

  /// A URL-safe, human-readable identifier, generated from `name` at
  /// creation time. Not used for routing yet (routes use `id`) - it exists
  /// now because retrofitting a unique slug onto an existing table later,
  /// once organizations already exist with colliding names, is more painful
  /// than reserving the column now.
  slug String @unique @db.VarChar(160)

  memberships Membership[]
  teams       Team[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

/// Which role a Membership grants within its Organization.
///
/// MANAGER exists in the schema now but isn't given any distinct
/// permissions yet - Phase 06 (RBAC) is where ADMIN/MANAGER/MEMBER actually
/// diverge in what they're allowed to do. For this phase, every check that
/// cares about role only distinguishes ADMIN from "everyone else".
enum MembershipRole {
  ADMIN
  MANAGER
  MEMBER
}

/// The join model connecting a User to an Organization, with a role. This
/// is the single source of truth for "who belongs to which organization,
/// and with what permissions" - every tenant-isolation check in the app
/// ultimately comes down to "does a Membership row exist for this
/// user+organization pair".
model Membership {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @map("user_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  role MembershipRole @default(MEMBER)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// A user can only have ONE membership (one role) per organization -
  /// prevents duplicate/conflicting rows for the same user+org pair.
  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

/// A smaller working group WITHIN an organization - e.g. "Engineering" or
/// "Design". A Team belongs to exactly one Organization; it does not exist
/// independently. Deleting an Organization cascades to delete its Teams.
///
/// Any member of an Organization can currently create a Team and see every
/// Team in their Organization (teams are not private groups within a
/// tenant - the tenant boundary is the Organization, not the Team). Only a
/// Team's own LEAD can rename it, delete it, or manage its membership.
model Team {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name           String @db.VarChar(150)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  TeamMembership[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("teams")
}

/// Which role a TeamMembership grants within its Team. Deliberately a
/// separate enum from MembershipRole - team-level permissions and
/// organization-level permissions are different concerns, and reusing one
/// enum for both would blur that a user's ADMIN status in the organization
/// says nothing about their role (or even membership) in any given Team.
enum TeamRole {
  LEAD
  MEMBER
}

/// The join model connecting a User to a Team. A precondition enforced in
/// application code (not the database): a user can only be added to a Team
/// if they are already a member of that Team's Organization - see
/// TeamsService.addMember() and docs/phase-05-concepts.md.
model TeamMembership {
  id     String @id @default(uuid()) @db.Uuid
  teamId String @map("team_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  role TeamRole @default(MEMBER)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([userId])
  @@map("team_memberships")
}

# ---------------------------------------------------------------------------
# TaskForge frontend environment (copy to .env - never commit the real file)
# ---------------------------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to browser code, and
# EVERYTHING it exposes is visible to anyone who opens the page. Never put a
# secret in a VITE_ variable: this value is a public URL, not a credential.

# Base URL of the TaskForge backend API (no trailing slash needed).
VITE_API_URL=http://localhost:3000
